    "@pierre/trees": "1.0.0-beta.6",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/store": "^0.11.1",
    "@tiptap/core": "^3.30.0",
    "@tiptap/markdown": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ghostty-web": "^0.4.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "motion": "^13.0.0",
